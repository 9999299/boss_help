{
  "manifest_version": 3,
  "name": "AI Resume Generator",
  "version": "1.0.0",
  "description": "通过AI识别职位要求并生成针对性简历",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "action": {
    "default_title": "AI Resume Generator"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
