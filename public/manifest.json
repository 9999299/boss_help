{
  "manifest_version": 3,
  "name": "boss_help",
  "version": "1.0.0",
  "description": "AI 分析职位要求并生成针对性简历",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "action": {
    "default_title": "boss_help"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
