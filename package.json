{
  "name": "chrome-resume-generator",
  "version": "1.0.0",
  "description": "\u901a\u8fc7AI\u8bc6\u522b\u804c\u4f4d\u8981\u6c42\u5e76\u751f\u6210\u9488\u5bf9\u6027\u7b80\u5386",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "webpack serve --mode development --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check:secrets": "node scripts/check-secrets.cjs",
    "probe:api": "node scripts/probe-api.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "dev:api": "node --env-file-if-exists=.env scripts/dev-api.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "docx": "^9.15.3",
    "mammoth": "^1.13.0",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
