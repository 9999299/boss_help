# 前端只需要公开的后端地址（不要放模型 API key）
ANALYZE_API_URL=http://localhost:3000

# Vercel/API 服务端环境变量
AI_API_KEY=your_model_api_key_here
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=mimo-v2.5
# 可选：chat（默认）或 responses
AI_API_MODE=chat
# 可选：OpenRouter 等推理模型可设为 off/low/medium/high；off 可降低超时与 JSON 截断风险
AI_REASONING=off
# 可选：单次模型请求超时（毫秒）。免费推理模型较慢，建议 300000
AI_TIMEOUT_MS=300000
ALLOWED_ORIGINS=http://localhost:3000

# 经历库/岗位定制的签名会话密钥。生产必须设置固定随机值，否则多实例会话不互通。
SESSION_SECRET=replace_with_a_long_random_string

# 可选 PostgreSQL。未配置时使用进程内存储，仅适合本地调试，Vercel 冷启动会丢失任务状态。
DATABASE_URL=postgres://user:password@host:5432/database
# 托管数据库通常需要 TLS；本地 PostgreSQL 可设为 disable
PGSSL=disable
